{
	"name": "open-to-spick-and-span-window",
	"displayName": "Open to Spick and Span Window",
	"description": "Open a folder in a new window",
	"version": "0.3.0",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"publisher": "zokugun",
	"license": "MIT",
	"homepage": "https://github.com/zokugun/vscode-open-to-spick-and-span-window",
	"repository": {
		"type": "git",
		"url": "https://github.com/zokugun/vscode-open-to-spick-and-span-window.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/vscode-open-to-spick-and-span-window/discussions/categories/issue-triage"
	},
	"engines": {
		"vscode": "^1.56.0"
	},
	"main": "./lib/index.js",
	"browser": "./lib/index.js",
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "ncc build out/extension --out lib",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib out *.vsix",
		"compile:src": "tsc -p src",
		"lint": "xo",
		"lint:all": "npm audit && npm run lint:package && npm run ci:lint && npm run lint",
		"lint:fix": "xo --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf *.vsix && vsce package",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p src --onSuccess 'npm run bundle'"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@types/vscode": "1.56.0",
		"@vercel/ncc": "0.38.4",
		"@vscode/vsce": "3.9.2",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.0",
		"rimraf": "6.1.3",
		"taze": "19.14.1",
		"tsc-watch": "7.2.0",
		"typescript": "5.9.3",
		"xo": "0.60.0"
	},
	"overrides": {
		"release-it": {
			"undici": "7.28.0"
		}
	},
	"allowScripts": {
		"@vscode/vsce-sign": true,
		"keytar": true
	},
	"activationEvents": [
		"onStartupFinished",
		"onCommand:openSpickSpanWindow.openFolder",
		"onCommand:openSpickSpanWindow.pickFolder"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "openSpickSpanWindow.openFolder",
				"title": "Open in New Window"
			},
			{
				"command": "openSpickSpanWindow.pickFolder",
				"title": "Pick Folder",
				"category": "Open in New Window"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "openSpickSpanWindow.openFolder",
					"group": "navigation@99"
				}
			],
			"commandPalette": [
				{
					"command": "openSpickSpanWindow.openFolder",
					"when": "never"
				}
			]
		}
	},
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#8DBC00",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"keywords": [],
	"extensionKind": [
		"ui",
		"workspace"
	]
}
